# NNMFB Transfer Portal — public_html/transfer entry
# Extract Package B so this file lives at: public_html/transfer/.htaccess
# Portal URL: https://nigerianavymfb.com/transfer

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    RewriteBase /transfer/

    # Deny direct web access to sensitive application paths
    RewriteRule ^(\.env|composer\.(json|lock)|artisan|phpunit\.xml)($|/) - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|vendor|tests|docs|deploy|scripts)($|/) - [F,L]

    # Authorization header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Trailing slash redirect for non-folders
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Front controller
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "(^\.env|composer\.(json|lock)|artisan|phpunit\.xml)$">
        Require all denied
    </FilesMatch>
</IfModule>

# Disable directory listing
Options -Indexes
