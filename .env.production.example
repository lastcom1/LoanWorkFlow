############################################################
# PRODUCTION environment template — NNMFB Transfer Portal
# Copy to .env on the server (~/nnmfb-portal/.env).
# Do NOT use .env.example (local/dev defaults) for production.
############################################################

APP_NAME="NNMFB Transfer Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nigerianavymfb.com/transfer

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Zoho SMTP — real credentials via server env / secrets manager only
MAIL_MAILER=smtp
MAIL_HOST=smtp.zoho.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@nigerianavymfb.com
MAIL_FROM_NAME="NNMFB Transfer Portal"

# Installer MUST stay off after go-live
INSTALLER_ENABLED=false
INSTALLER_SETUP_SECRET=

# Never seed DEMO users in production
SEED_DEMO_DATA=false
