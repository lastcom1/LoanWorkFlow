APP_NAME="NNMFB Transfer Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Local: http://127.0.0.1:8000
# cPanel subdirectory deploy: https://nigerianavymfb.com/transfer
APP_URL=http://127.0.0.1:8000
# Optional: force asset URL for subdirectory installs (usually same as APP_URL)
# ASSET_URL=https://nigerianavymfb.com/transfer

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local XAMPP / SQLite default for quick start
DB_CONNECTION=sqlite
# For MySQL / MariaDB (XAMPP or cPanel):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=nnmfb_portal
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Zoho SMTP — configure via environment only (never commit real secrets)
MAIL_MAILER=smtp
MAIL_HOST=smtp.zoho.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Web installer — OFF by default. Enable only for first-time shared-hosting setup,
# then run: php artisan installer:lock  (and set INSTALLER_ENABLED=false)
INSTALLER_ENABLED=false
INSTALLER_SETUP_SECRET=

# Seed DEMO users/tickets only outside production (DatabaseSeeder respects this).
# Production: use `php artisan db:seed --class=ProductionSeeder` then create a real admin.
SEED_DEMO_DATA=true

# Production hardening (Package B / cPanel)
# APP_ENV=production
# APP_DEBUG=false
# SESSION_SECURE_COOKIE=true
# SEED_DEMO_DATA=false

